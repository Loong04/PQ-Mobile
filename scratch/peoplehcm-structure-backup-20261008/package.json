{
  "name": "peoplehcm-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write src public/web-adapter vite.config.ts tsconfig.json package.json",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "inventory": "node scripts/inventory.mjs",
    "export:sql": "node scripts/export-data.mjs",
    "migrate": "node scripts/migrate-source.mjs",
    "test:browser": "node tests/web-native.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "acorn": "^8.15.0",
    "prettier": "^3.6.2",
    "puppeteer": "^25.11.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
